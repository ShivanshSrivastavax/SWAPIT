generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String   @map("password_hash")
  avatar        String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  hostedRooms   Room[]         @relation("HostedRooms")
  roomPlayers   RoomPlayer[]
  gamePlayers   GamePlayer[]
  wonGames      Game[]         @relation("GameWinner")
  messages      Message[]
  refreshTokens RefreshToken[]

  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  friendsA         Friend[]        @relation("FriendA")
  friendsB         Friend[]        @relation("FriendB")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}

enum RoomStatus {
  waiting
  playing
  finished
}

model Room {
  id        String       @id @default(cuid())
  roomCode  String       @unique @map("room_code")
  hostId    String       @map("host_id")
  host      User         @relation("HostedRooms", fields: [hostId], references: [id])
  status    RoomStatus   @default(waiting)
  maxPlayers Int         @default(4) @map("max_players")
  createdAt DateTime     @default(now()) @map("created_at")

  players  RoomPlayer[]
  games    Game[]
  messages Message[]

  @@map("rooms")
}

model RoomPlayer {
  id       String   @id @default(cuid())
  roomId   String   @map("room_id")
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isBot    Boolean  @default(false) @map("is_bot")
  botName  String?  @map("bot_name")
  joinedAt DateTime @default(now()) @map("joined_at")

  // NOTE: no unique(roomId, userId) constraint -- bots are stored as rows
  // that reuse the host's userId as a placeholder FK (isBot distinguishes
  // them), so uniqueness on that pair can't be a hard DB constraint.
  // Duplicate-join prevention for real players is handled in application code.
  @@map("room_players")
}

model Game {
  id         String    @id @default(cuid())
  roomId     String    @map("room_id")
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winnerId   String?   @map("winner_id")
  winner     User?     @relation("GameWinner", fields: [winnerId], references: [id])
  winnerName String?   @map("winner_name") // used when the winner is a bot (no User row)
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")

  players GamePlayer[]

  @@map("games")
}

model GamePlayer {
  id        String  @id @default(cuid())
  gameId    String  @map("game_id")
  game      Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Int
  cardsLeft Int     @map("cards_left")
  isWinner  Boolean @default(false) @map("is_winner")

  @@unique([gameId, userId])
  @@map("game_players")
}

model Message {
  id        String   @id @default(cuid())
  roomId    String   @map("room_id")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
}

model FriendRequest {
  id         String               @id @default(cuid())
  fromId     String               @map("from_id")
  from       User                 @relation("SentRequests", fields: [fromId], references: [id], onDelete: Cascade)
  toId       String               @map("to_id")
  to         User                 @relation("ReceivedRequests", fields: [toId], references: [id], onDelete: Cascade)
  status     FriendRequestStatus  @default(pending)
  createdAt  DateTime             @default(now()) @map("created_at")

  @@unique([fromId, toId])
  @@map("friend_requests")
}

model Friend {
  id        String   @id @default(cuid())
  userAId   String   @map("user_a_id")
  userA     User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String   @map("user_b_id")
  userB     User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userAId, userBId])
  @@map("friends")
}
